{
  "name": "@facile/blob",
  "version": "0.2.0",
  "description": "Deterministic blob avatars for Svelte 5, with a Go terminal renderer",
  "type": "module",
  "svelte": "./src/lib/index.ts",
  "main": "./src/lib/index.ts",
  "exports": {
    ".": {
      "svelte": "./src/lib/index.ts",
      "types": "./src/lib/index.ts",
      "default": "./src/lib/index.ts"
    },
    "./motion.css": "./src/lib/motion.css",
    "./gaze.css": "./src/lib/gaze.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "src/lib",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "bun test"
  },
  "peerDependencies": {
    "svelte": "^5.29.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "svelte": "^5.51.0",
    "svelte-check": "^4.4.2",
    "typescript": "^5.9.3"
  },
  "keywords": ["svelte", "avatar", "identicon", "blob", "facile"],
  "license": "MIT"
}
